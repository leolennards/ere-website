# ── Required ──────────────────────────────────────────────────────────────
# PostgreSQL connection string.
#   Local (embedded PGlite server, started with `npm run db:local`):
#     postgresql://postgres:postgres@127.0.0.1:5433/postgres?sslmode=disable
#   Production: the pooled URL from Neon / your managed Postgres provider.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/postgres?sslmode=disable

# Long random string used to salt rate-limit hashes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=replace-with-a-long-random-string

# Public canonical URL (no trailing slash). Used for metadata, sitemaps and links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Optional: image storage ───────────────────────────────────────────────
# When set, uploads go to Vercel Blob (required on Vercel). Otherwise files
# are written to UPLOADS_DIR on the local disk (development only).
BLOB_READ_WRITE_TOKEN=
UPLOADS_DIR=.data/uploads

# ── Optional: Google Maps (Maps Embed API) ────────────────────────────────
# Browser key restricted to your domains (HTTP referrers) and to the
# "Maps Embed API" only. Without it, maps fall back to "Open in Google Maps".
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=

# ── Optional: enquiry notification emails (Resend) ────────────────────────
RESEND_API_KEY=
# A sender on a domain verified in Resend, e.g. "ERE Website <website@elevaterealestate.co.za>"
EMAIL_FROM=
# Inbox that receives "new enquiry" notifications.
NOTIFY_EMAIL_TO=

# ── Optional: database pool size (defaults: 1 locally, 5 in production) ──
DATABASE_POOL_MAX=
